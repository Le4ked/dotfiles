{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "mode": "primary"
    },
    "build": {
      "mode": "primary"
    },
    "general": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "high"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "low"
    },
    "senior": {
      "model": "openai/GPT-5.5",
      "variant": "high"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "plugin": [
    "magic-compact"
  ]
}
